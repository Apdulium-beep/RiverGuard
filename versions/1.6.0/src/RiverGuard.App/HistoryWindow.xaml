<Window x:Class="RiverGuard.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RiverGuard · История расчётов" Width="1120" Height="760" MinWidth="850" MinHeight="550" WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI">
    <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="История расчётов" Style="{StaticResource Title}"/><TextBlock Text="Снимки входных данных и сводки результатов хранятся в проекте. Разница = второй запуск − первый. Отсутствующее событие не считается нулём." Style="{StaticResource MutedText}"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Первый запуск / данные для нового расчёта" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="FirstRun" DisplayMemberPath="Label" SelectionChanged="Selection_Changed"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="Второй запуск для сравнения" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="SecondRun" DisplayMemberPath="Label" SelectionChanged="Selection_Changed"/></StackPanel>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="1" Margin="0"><DataGrid x:Name="ComparisonGrid" IsReadOnly="True" RowHeight="NaN" MinRowHeight="40"><DataGrid.Columns>
            <DataGridTextColumn Header="Показатель" Binding="{Binding Quantity}" Width="2*"/><DataGridTextColumn Header="Первый" Binding="{Binding First}" Width="*"/><DataGridTextColumn Header="Второй" Binding="{Binding Second}" Width="*"/><DataGridTextColumn Header="Разница" Binding="{Binding Difference}" Width="*"/>
        </DataGrid.Columns></DataGrid></Border>
        <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HistoryHint" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,16,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="TakeInputButton" Content="Взять данные в новый расчёт" Click="TakeInput_Click" Style="{StaticResource Primary}"/><Button Content="Закрыть" Click="Close_Click"/></StackPanel></Grid>
    </Grid>
</Window>
