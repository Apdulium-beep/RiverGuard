<Window x:Class="RiverGuard.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:RiverGuard.Controls" Title="RiverGuard — моделирование волны прорыва" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13" Width="1480" Height="940" MinWidth="1150" MinHeight="760" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Page" TargetType="Grid"><Setter Property="Margin" Value="32,24,18,16"/></Style>
        <Style x:Key="ProjectCardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CardSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardSurface" Property="BorderBrush" Value="#56DCC2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="CardSurface" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <!-- Навигация -->
        <Border x:Name="WorkspaceSidebar" Grid.RowSpan="3" Background="#101A2C" BorderBrush="#243149" BorderThickness="0,0,1,0">
            <DockPanel Margin="17,23,17,16">
                <StackPanel DockPanel.Dock="Top" Margin="10,0,0,30">
                    <StackPanel Orientation="Horizontal"><Border Width="32" Height="32" CornerRadius="10" Background="#4CE0C1"><TextBlock Text="≈" Foreground="#0B302D" FontSize="27" HorizontalAlignment="Center" Margin="0,-5,0,0"/></Border><TextBlock Text="RiverGuard" FontSize="22" FontWeight="SemiBold" Margin="10,1,0,0"/></StackPanel>
                    <TextBlock Text="ГИДРОДИНАМИЧЕСКАЯ ЛАБОРАТОРИЯ" FontSize="8" Foreground="#7C94B2" Margin="0,12,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="#172C37" CornerRadius="12" Padding="13" Margin="0,12,0,14"><StackPanel><TextBlock Text="RG-1D · Research edition" Foreground="#62DEC4" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="Прозрачная модель.&#10;Проверяемые результаты." Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel></Border>
                    <Button Content="⌂  Все проекты" Click="Home_Click" FontSize="12" Margin="0,0,0,8"/><Button Content="↗  Открыть папку проекта" Click="OpenFolder_Click" FontSize="11" Padding="8,10" Margin="0"/>
                </StackPanel>
                <ListBox x:Name="Navigation" SelectionChanged="Navigation_Changed" SelectedIndex="0" ItemContainerStyle="{StaticResource NavItem}">
                    <ListBoxItem Content="◈    Обзор проекта"/>
                    <ListBoxItem Content="◉    Сценарий аварии"/>
                    <ListBoxItem Content="≋    Створы и рельеф"/>
                    <ListBoxItem Content="⌁    Анализ и графики"/>
                    <ListBoxItem Content="▦    Изодаты"/>
                    <ListBoxItem Content="↗    Отчёт и экспорт"/>
                    <ListBoxItem Content="ⓘ    Модель и ограничения"/>
                    <ListBoxItem Content="▧    Каталог примеров"/>
                </ListBox>
            </DockPanel>
        </Border>
        <!-- Панель окна -->
        <Border x:Name="WorkspaceHeader" Grid.Column="1" Background="#0F1727" BorderBrush="#26344B" BorderThickness="0,0,0,1" MouseLeftButtonDown="Title_Drag">
            <Grid Margin="26,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="#4CE0C1"/><TextBlock Text="ЛОКАЛЬНОЕ РАБОЧЕЕ ПРОСТРАНСТВО" Foreground="#8EA6C4" FontSize="10" Margin="9,0,0,0"/><TextBlock x:Name="SavedBadge" Text=" •  Новый проект" Foreground="#526B8A" FontSize="10" Margin="12,0" MaxWidth="220" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Открыть" Click="Open_Click" Padding="12,6" FontSize="11"/><Button Content="Сохранить" Click="Save_Click" Padding="12,6" FontSize="11"/><Button Content="─" Click="Minimize_Click" Padding="12,5" Background="Transparent" BorderBrush="Transparent"/><Button Content="□" Click="Maximize_Click" Padding="12,5" Background="Transparent" BorderBrush="Transparent"/><Button Content="✕" Click="Close_Click" Padding="12,5" Background="Transparent" BorderBrush="Transparent"/></StackPanel>
            </Grid>
        </Border>
        <!-- Страницы -->
        <Grid Grid.Column="1" Grid.Row="1" x:Name="Pages">
            <Grid x:Name="Overview" Style="{StaticResource Page}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,14,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Вода. Рельеф. Последствия." Style="{StaticResource Title}"/><TextBlock Text="От исходных данных — к понятной картине распространения волны." Style="{StaticResource MutedText}"/><WrapPanel Margin="0,12,0,0"><TextBlock Text="{Binding Project.Name}" Foreground="#56DCC2" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Переименовать" Click="RenameProject_Click" Padding="9,5" FontSize="10" Margin="0"/></WrapPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="＋ Новый" Click="New_Click"/><Button x:Name="RunButton" Content="▶  Рассчитать сценарий" Style="{StaticResource Primary}" Click="Run_Click"/></StackPanel></Grid>
                <UniformGrid Grid.Row="1" Columns="4">
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="МАКСИМАЛЬНЫЙ РАСХОД" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Text="{Binding FlowMetric}" FontSize="29" FontWeight="SemiBold" Margin="0,12,0,3"/><TextBlock Text="м³/с · по расчётным створам" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="ПОДЪЁМ ОТ АВАРИИ" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Text="{Binding HeightMetric}" FontSize="29" FontWeight="SemiBold" Foreground="#64DFC6" Margin="0,12,0,3"/><TextBlock Text="м · относительно безаварийного расчёта" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="ЗАТОПЛЕНИЕ ПОЙМЫ" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Text="{Binding AreaMetric}" FontSize="29" FontWeight="SemiBold" Margin="0,12,0,3"/><TextBlock Text="га · между заданными створами" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="БАЛАНС ОБЪЁМА" Style="{StaticResource MutedText}" FontSize="10"/><TextBlock Text="{Binding BalanceMetric}" FontSize="29" FontWeight="SemiBold" Foreground="#9DAAFF" Margin="0,12,0,3"/><TextBlock Text="% · невязка массы воды" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel></Border>
                </UniformGrid>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.75*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock x:Name="OverviewFlowTitle" Text="Гидрограф прорана" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/><TextBlock x:Name="OverviewFlowHint" Text="Изменение расхода через проран во времени" Style="{StaticResource MutedText}"/></StackPanel><c:ChartView x:Name="OverviewChart" Grid.Row="1" Margin="0,15,0,0"/></Grid></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}"><ScrollViewer><StackPanel><TextBlock Text="Рабочий сценарий" Style="{StaticResource SectionTitle}"/><TextBlock Text="Численная модель Сен-Венана, HLL-потоки, трение Маннинга и отдельный баланс водохранилища." Style="{StaticResource MutedText}" Margin="0,0,0,16"/><Button Content="Настроить исходные данные  →" Click="Scenario_Click" HorizontalAlignment="Left" FontSize="11" Margin="0,0,0,16"/><TextBlock Text="БЫСТРЫЙ СТАРТ" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,10"/><Button Content="Демонстрационная долина" Click="Demo_Click" HorizontalAlignment="Stretch" Margin="0,0,0,9"/><Button Content="Три створа · пример параметров" Click="ThreeSections_Click" HorizontalAlignment="Stretch" Margin="0,0,0,15"/><TextBlock Text="Последние проекты" Style="{StaticResource MutedText}" Margin="0,0,0,6"/><ListBox x:Name="RecentList" MouseDoubleClick="Recent_Open" FontSize="11"/></StackPanel></ScrollViewer></Border>
                </Grid>
                <Border Grid.Row="3" Background="#2B251E" BorderBrush="#685334" BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,14,0"><TextBlock Text="Исследовательская версия · Не заменяет утверждённую методику расчёта аварии ГТС. Зоны — сценарная оценка, а не основание для эвакуации." Foreground="#DBC195" FontSize="11"/></Border>
            </Grid>
            <!-- Исходные параметры -->
            <Grid x:Name="ScenarioPage" Style="{StaticResource Page}" Visibility="Collapsed"><ScrollViewer><StackPanel>
                <TextBlock x:Name="ScenarioPageTitle" Text="Сценарий аварии" Style="{StaticResource Title}"/><TextBlock x:Name="ScenarioPageHint" Text="Абсолютные отметки в одной системе высот. Параметры прорана задаются независимо от уровня воды." Style="{StaticResource MutedText}" Margin="0,0,0,22"/>
                <UniformGrid Columns="2">
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="01  Водохранилище" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Уровень воды, м" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.ReservoirLevel}" Margin="0,0,0,13"/>
                        <TextBlock Text="Отметка дна у плотины, м" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.DamBed}" Margin="0,0,0,13"/>
                        <TextBlock Text="Объём воды, млн м³" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.ReservoirVolume}" Margin="0,0,0,13"/>
                        <TextBlock Text="Площадь зеркала, км²" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.ReservoirArea}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock x:Name="OpeningBlockTitle" Text="02  Заданный проран" Style="{StaticResource SectionTitle}"/>
                        <StackPanel x:Name="OpeningWidthFields"><TextBlock x:Name="OpeningWidthLabel" Text="Конечная ширина прорана, м" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.BreachWidth}" Margin="0,0,0,13"/></StackPanel>
                        <StackPanel x:Name="GateHeightFields" Visibility="Collapsed"><TextBlock Text="Максимальная высота открытия затвора, м" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.GateHeight}" Margin="0,0,0,13"/></StackPanel>
                        <StackPanel x:Name="CircularFields" Visibility="Collapsed"><TextBlock Text="Диаметр круглого отверстия, м (0 — закрыто)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.OutletDiameter}" Margin="0,0,0,13"/></StackPanel>
                        <TextBlock x:Name="SillLabel" Text="Абсолютная отметка порога прорана, м" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.SillElevation}" Margin="0,0,0,13"/>
                        <StackPanel x:Name="FormationFields"><TextBlock x:Name="FormationLabel" Text="Время линейного раскрытия, мин (0 — мгновенно)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.FormationMinutes}" Margin="0,0,0,13"/></StackPanel>
                        <TextBlock Text="Коэффициент расхода Cd, безразмерный" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.DischargeCoefficient}"/>
                        <TextBlock x:Name="OpeningModeHint" Style="{StaticResource MutedText}" Margin="0,13,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="03  Нижний бьеф" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Начальная глубина, м" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.LowerDepth}" Margin="0,0,0,13"/>
                        <TextBlock Text="Начальная ширина русла, м" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.LowerWidth}" Margin="0,0,0,13"/>
                        <TextBlock Text="Начальная скорость, м/с" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.LowerVelocity}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="04  Численная модель" Style="{StaticResource SectionTitle}"/>
                        <UniformGrid Columns="2"><StackPanel Margin="0,0,12,13"><TextBlock Text="Продолжительность, ч" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.DurationHours}"/></StackPanel><StackPanel Margin="0,0,0,13"><TextBlock Text="Ячейки сетки (40–400)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.Cells}"/></StackPanel></UniformGrid>
                        <TextBlock Text="Приход: подъём над безаварийным расчётом, м" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.ArrivalThreshold}" Margin="0,0,0,13"/>
                        <TextBlock Text="Порог экстренной зоны, ч (не более 4)" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Project.EvacuationHours}"/>
                    </StackPanel></Border>
                </UniformGrid>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Заметки и происхождение данных" Style="{StaticResource SectionTitle}"/><TextBox Text="{Binding Project.Notes}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90"/></StackPanel></Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><Button Content="▶  Выполнить расчёт" Style="{StaticResource Primary}" Click="Run_Click"/><Button Content="Проверить исходные данные" Click="Validate_Click"/></StackPanel>
            </StackPanel></ScrollViewer></Grid>
            <!-- Створы -->
            <Grid x:Name="SectionsPage" Style="{StaticResource Page}" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1.1*"/><RowDefinition Height="1*"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="Геометрия имеет значение" Style="{StaticResource Title}"/><TextBlock Text="Все горизонтали участвуют в расчёте. Расстояния по берегам — положительные, от фарватера." Style="{StaticResource MutedText}" Margin="0,0,0,18"/></StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14"><Button Content="＋ Створ" Click="AddSection_Click"/><Button Content="Дублировать" Click="CopySection_Click"/><Button Content="Удалить" Click="DeleteSection_Click"/><Button Content="Сортировать по удалению" Click="SortSections_Click"/></StackPanel>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="1"><DataGrid x:Name="SectionsGrid" ItemsSource="{Binding Project.Sections}" SelectedItem="{Binding SelectedSection}" SelectionChanged="Section_Changed" CellEditEnding="Section_Edit"><DataGrid.Columns>
                    <DataGridTextColumn Header="Створ" Binding="{Binding Name}" Width="135"/>
                    <DataGridTextColumn Header="Удаление, м" Binding="{Binding Distance, StringFormat=F1}" Width="110"/>
                    <DataGridTextColumn Header="Дно, м" Binding="{Binding Bed, StringFormat=F3}" Width="88"/>
                    <DataGridTextColumn Header="H быт., м" Binding="{Binding NormalDepth}" Width="90"/>
                    <DataGridTextColumn Header="Левый, м" Binding="{Binding LeftWidth}" Width="90"/>
                    <DataGridTextColumn Header="Правый, м" Binding="{Binding RightWidth}" Width="95"/>
                    <DataGridTextColumn Header="V быт., м/с" Binding="{Binding InitialVelocity}" Width="100"/>
                    <DataGridTextColumn Header="n Маннинга" Binding="{Binding Manning}" Width="105"/>
                    <DataGridTextColumn Header="K осушения" Binding="{Binding DrainageFactor}" Width="105"/>
                </DataGrid.Columns></DataGrid></Border>
                <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Левый берег" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button Content="＋ Точка" Tag="left" Click="AddBank_Click" Padding="9,6" FontSize="11"/><Button Content="−" Tag="left" Click="DeleteBank_Click" Padding="9,6"/></StackPanel></StackPanel><DataGrid x:Name="LeftGrid" ItemsSource="{Binding SelectedSection.LeftBank}" CellEditEnding="Section_Edit"><DataGrid.Columns><DataGridTextColumn Header="От оси, м" Binding="{Binding Distance}" Width="*"/><DataGridTextColumn Header="Отметка, м" Binding="{Binding Elevation}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Правый берег" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button Content="＋ Точка" Tag="right" Click="AddBank_Click" Padding="9,6" FontSize="11"/><Button Content="−" Tag="right" Click="DeleteBank_Click" Padding="9,6"/></StackPanel></StackPanel><DataGrid x:Name="RightGrid" ItemsSource="{Binding SelectedSection.RightBank}" CellEditEnding="Section_Edit"><DataGrid.Columns><DataGridTextColumn Header="От оси, м" Binding="{Binding Distance}" Width="*"/><DataGridTextColumn Header="Отметка, м" Binding="{Binding Elevation}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12"><c:ChartView x:Name="EditorProfile"/></Border>
                </Grid>
            </Grid>
            <!-- Анализ -->
            <Grid x:Name="ChartsPage" Style="{StaticResource Page}" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="0.85*"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="Волна в деталях" Style="{StaticResource Title}"/><TextBlock Text="Динамика потока и сценарные границы. Наведите курсор на график, чтобы увидеть значения." Style="{StaticResource MutedText}" Margin="0,0,0,18"/></StackPanel>
                <WrapPanel Grid.Row="1" Margin="0,0,0,14"><ComboBox x:Name="ResultSectionBox" DisplayMemberPath="Name" SelectionChanged="ResultSelection_Changed"/><ComboBox x:Name="ChartTypeBox" SelectedIndex="0" SelectionChanged="ChartType_Changed" Margin="12,0,0,0"><ComboBoxItem Content="Глубина во времени"/><ComboBoxItem Content="Расход во времени"/><ComboBoxItem Content="Скорость во времени"/><ComboBoxItem Content="Времена добегания"/><ComboBoxItem Content="Зоны по длине реки"/><ComboBoxItem Content="Уровень водохранилища"/></ComboBox><Button Content="Сохранить PNG" Click="SaveChart_Click" Margin="12,0,0,0"/><Border Background="#19283E" CornerRadius="8" Padding="8,3" Margin="12,0,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Content="▶" Click="Play_Click" Padding="10,5" Background="#214D4E" BorderBrush="#346F68"/><Slider x:Name="TimeSlider" Width="130" Minimum="0" Maximum="2" ValueChanged="Time_Changed" VerticalAlignment="Center"/><TextBlock x:Name="TimeLabel" Text="0,000 ч" VerticalAlignment="Center" Foreground="#65E6CB" FontSize="11" Margin="10,0,3,0" MinWidth="55"/></StackPanel></Border></WrapPanel>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource CardStyle}" Padding="14"><c:ChartView x:Name="AnalysisChart"/></Border><Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14"><c:ChartView x:Name="ResultProfile"/></Border></Grid>
                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="1"><DataGrid ItemsSource="{Binding Results}" IsReadOnly="True"><DataGrid.Columns>
                    <DataGridTextColumn Header="Створ" Binding="{Binding Name}" Width="115"/><DataGridTextColumn Header="L, м" Binding="{Binding Distance, StringFormat=F0}" Width="80"/><DataGridTextColumn Header="Z max, м" Binding="{Binding MaxLevel, StringFormat=F3}" Width="95"/><DataGridTextColumn Header="H max, м" Binding="{Binding MaxDepth, StringFormat=F3}" Width="95"/><DataGridTextColumn Header="Волна, м" Binding="{Binding WaveHeight, StringFormat=F3}" Width="95"/><DataGridTextColumn Header="Q max, м³/с" Binding="{Binding MaxDischarge, StringFormat=F3}" Width="115"/><DataGridTextColumn Header="V max, м/с" Binding="{Binding MaxVelocity, StringFormat=F3}" Width="110"/><DataGridTextColumn Header="Фронт, ч" Binding="{Binding ArrivalHours, StringFormat=F3, TargetNullValue=—}" Width="95"/><DataGridTextColumn Header="Гребень, ч" Binding="{Binding PeakHours, StringFormat=F3}" Width="95"/><DataGridTextColumn Header="Эвакуация" Binding="{Binding Evacuation}" Width="190"/>
                </DataGrid.Columns></DataGrid></Border>
            </Grid>
            <!-- Изодаты -->
            <Grid x:Name="IsoPage" Style="{StaticResource Page}" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Поперечная картина" Style="{StaticResource Title}"/><TextBlock Text="Глубина, положение изодаты и распределение скорости при максимальном уровне. Шаг глубины — 1 м." Style="{StaticResource MutedText}" Margin="0,0,0,18"/></StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14"><ComboBox x:Name="IsoSectionBox" SelectionChanged="IsoFilter_Changed" MinWidth="180"/><ComboBox x:Name="IsoBankBox" SelectionChanged="IsoFilter_Changed" SelectedIndex="0" Margin="12,0,0,0"><ComboBoxItem Content="Оба берега"/><ComboBoxItem Content="Левый"/><ComboBoxItem Content="Правый"/></ComboBox><Button Content="Экспорт CSV" Click="Csv_Click" Margin="12,0,0,0"/></StackPanel>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="1"><DataGrid ItemsSource="{Binding FilteredIsolines}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Створ" Binding="{Binding Section}" Width="*"/><DataGridTextColumn Header="Берег" Binding="{Binding Bank}" Width="*"/><DataGridTextColumn Header="Глубина, м" Binding="{Binding Depth, StringFormat=F3}" Width="*"/><DataGridTextColumn Header="От фарватера, м" Binding="{Binding Distance, StringFormat=F3}" Width="*"/><DataGridTextColumn Header="Скорость, м/с" Binding="{Binding Velocity, StringFormat=F3}" Width="*"/><DataGridTextColumn Header="Осушение от гребня, ч" Binding="{Binding DryingHours, StringFormat=F3, TargetNullValue=не определено}" Width="1.4*"/></DataGrid.Columns></DataGrid></Border>
            </Grid>
            <!-- Экспорт -->
            <Grid x:Name="ReportPage" Style="{StaticResource Page}" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Результат, который можно передать" Style="{StaticResource Title}"/><TextBlock Text="Отчёт связан со снимком исходных данных на момент расчёта. Изменённые входные данные не подменяют результаты." Style="{StaticResource MutedText}" Margin="0,0,0,22"/></StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}"><StackPanel>
                    <TextBlock Text="Выберите формат отчёта" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Excel и ODS — отдельные листы с числовыми ячейками. Word и HTML включают графики; остальные форматы — таблицы и текст. ZIP содержит весь комплект и изображения PNG." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
                    <WrapPanel><Button Content="Excel · XLSX" Tag="xlsx" Click="ExtendedExport_Click" Style="{StaticResource Primary}"/><Button Content="OpenDocument · ODS" Tag="ods" Click="ExtendedExport_Click"/><Button Content="Word · DOCX" Click="Word_Click"/><Button Content="HTML" Click="Html_Click"/><Button Content="CSV" Click="Csv_Click"/><Button Content="JSON" Click="ResultJson_Click"/></WrapPanel>
                    <WrapPanel Margin="0,8,0,0"><Button Content="RTF" Tag="rtf" Click="ExtendedExport_Click"/><Button Content="Текст · TXT" Tag="txt" Click="ExtendedExport_Click"/><Button Content="Markdown · MD" Tag="md" Click="ExtendedExport_Click"/><Button Content="XML" Tag="xml" Click="ExtendedExport_Click"/><Button Content="График · PNG" Click="SaveChart_Click"/><Button Content="Весь комплект · ZIP" Tag="zip" Click="ExtendedExport_Click"/></WrapPanel>
                    <TextBlock Text="PDF: экспортируйте HTML, откройте его в браузере и выберите «Печать → Сохранить как PDF». Установка Excel для экспорта XLSX не требуется." Style="{StaticResource MutedText}" FontSize="11" Margin="0,14,0,0"/>
                </StackPanel></Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Диагностика и границы применимости" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,0,0,14"/></StackPanel><ScrollViewer><ItemsControl ItemsSource="{Binding Warnings}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#19263A" CornerRadius="8" Padding="13" Margin="0,0,0,9"><TextBlock Text="{Binding}" Foreground="#BDCCE0" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></Border>
            </Grid>
            <!-- Каталог сценариев -->
            <Grid x:Name="CatalogPage" Style="{StaticResource Page}" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><TextBlock Text="Каталог исходных условий" Style="{StaticResource Title}"/><TextBlock Text="33 примера прорана и перелива. Затвор и круглое отверстие доступны при создании проекта; примеры не являются отдельными физическими моделями." Style="{StaticResource MutedText}" Margin="0,0,0,18"/></StackPanel>
                <Grid Grid.Row="1" Margin="0,0,14,18"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="CatalogCategory" SelectionChanged="CatalogFilter_Changed"/><TextBox Grid.Column="1" x:Name="CatalogSearch" TextChanged="CatalogSearch_Changed" Margin="12,0" ToolTip="Поиск по названию, описанию и изменяемым параметрам"/><TextBlock Grid.Column="2" x:Name="CatalogCount" Style="{StaticResource MutedText}" VerticalAlignment="Center"/></Grid>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="8"><ListBox x:Name="CatalogList" SelectionChanged="CatalogSelection_Changed" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemSurface" Background="#19283E" BorderBrush="#253B51" BorderThickness="1" CornerRadius="11" Padding="16"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#1C3B45"/><Setter TargetName="ItemSurface" Property="BorderBrush" Value="#4BAF9F"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemSurface" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Category}" Foreground="#69CDB9" FontSize="10" Margin="0,0,0,6"/><TextBlock Text="{Binding Name}" Foreground="#EDF4FF" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}"><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,0"><Button x:Name="ApplyPresetButton" Content="Загрузить сценарий  →" Style="{StaticResource Primary}" Click="ApplyPreset_Click" HorizontalAlignment="Stretch" Margin="0,0,0,10"/><Button x:Name="SavePresetButton" Content="Сохранить шаблон в файл…" Click="SavePreset_Click" HorizontalAlignment="Stretch" Margin="0"/></StackPanel><ScrollViewer><StackPanel><TextBlock x:Name="CatalogPreviewCategory" Foreground="#67DFC4" FontSize="11" Margin="0,0,0,10"/><TextBlock x:Name="CatalogPreviewName" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,15"/><TextBlock x:Name="CatalogPreviewDescription" Foreground="#B7C9DE" LineHeight="22" Margin="0,0,0,20"/><TextBlock Text="ЧТО ИЗМЕНЕНО" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,8"/><TextBlock x:Name="CatalogPreviewChanges" Foreground="#7EE7CF" LineHeight="21" Margin="0,0,0,20"/><TextBlock Text="ПАРАМЕТРЫ ШАБЛОНА" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,8"/><TextBlock x:Name="CatalogPreviewParameters" Foreground="#C6D5E6" LineHeight="23"/></StackPanel></ScrollViewer></DockPanel></Border>
                </Grid>
                <Border Grid.Row="3" Background="#2B251E" BorderBrush="#685334" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,14,0"><TextBlock Text="Шаблоны не добавляют новые физические механизмы. Каскад плотин, мосты, суффозия, эрозия, полностью сухое ложе и двумерное растекание в текущую модель не входят." Foreground="#DBC195" FontSize="11"/></Border>
            </Grid>
            <!-- Описание модели -->
            <Grid x:Name="AboutPage" Style="{StaticResource Page}" Visibility="Collapsed"><ScrollViewer><StackPanel>
                <TextBlock Text="Без чёрного ящика" Style="{StaticResource Title}"/><TextBlock Text="Что именно рассчитывает RiverGuard — и чего не обещает." Style="{StaticResource MutedText}" Margin="0,0,0,22"/>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="01  Гидродинамика" Style="{StaticResource SectionTitle}"/><TextBlock Text="Одномерные уравнения мелкой воды в консервативных переменных A и Q. Конечные объёмы, потоки HLL, гидростатическая реконструкция, адаптивный шаг CFL ≤ 0,35. Трение Маннинга интегрируется полунеявно. Геометрия сечения учитывает асимметрию русла и введённые горизонтали берегов." Foreground="#BFCEE2" LineHeight="23"/><TextBlock Text="∂A/∂t + ∂Q/∂x = 0       ·       ∂Q/∂t + ∂(Q²/A + gI₁)/∂x = S" Foreground="#65E6CB" FontSize="16" Margin="0,16,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="02  Водохранилище и отверстие" Style="{StaticResource SectionTitle}"/><TextBlock Text="Сосредоточенная модель водохранилища с постоянной площадью зеркала. Уровень падает по балансу объёма. Проран раскрывается линейно или мгновенно, при переливе длина гребня постоянна. Для этих режимов расход: Cd·b·√(2g)·max(hu³ᐟ² − hd³ᐟ², 0), с приближённым учётом подпора. У затвора растёт высота прямоугольного открытия, у круглого отверстия диаметр постоянен: расход определяется интегралом локального перепада напора по смоченной площади. Для новых режимов Cd относится к отверстию, не к водосливу. Эрозия, рост дефекта, прочность, длинные водоводы и обратный поток не моделируются. Входной импульс приближён по напору над нижней отметкой отверстия." Foreground="#BFCEE2" LineHeight="23"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="03  Геометрия и зоны" Style="{StaticResource SectionTitle}"/><TextBlock Text="Внутри бытового русла принят кусочно-линейный профиль, аппроксимирующий параболу. Берега заданы горизонталями; между створами геометрия интерполируется. За последней горизонталью профиль продолжается вверх — выход воды в эту область отмечается предупреждением. Границы поймы: глубина 0 м; сценарные опасные зоны: 1,5 м и 3 м. Это не нормативная классификация риска. В изодатах скорость распределена пропорционально h²ᐟ³ с нормировкой по расходу в момент максимального уровня. Осушение берётся из рассчитанной временной истории и умножается на пользовательский K; незавершённый спад не экстраполируется." Foreground="#BFCEE2" LineHeight="23"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="04  Важно для интерпретации" Style="{StaticResource SectionTitle}"/><TextBlock Text="Начальный поток не проходит отдельный стационарный разгон. Вклад аварии и приход волны определяются сравнением с отдельным безаварийным расчётом с закрытым прораном. Максимальные уровни и границы относятся к полному потоку и включают начальные переходные процессы. Нижняя граница — свободный выход. Сетка первого порядка сглаживает фронт; проверяйте сходимость на разных сетках. Не учитываются двумерное растекание, здания, мосты, наносы, эрозия и разрушение сооружений. Одномерная схема не является картой затопления на местности." Foreground="#E1C195" LineHeight="23"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="05  Об авторе" Style="{StaticResource SectionTitle}"/><TextBlock Text="RiverGuard · Автор приложения: Apdulium-beep" Foreground="#56DCC2" FontSize="19" Margin="0,0,0,12"/><TextBlock Text="Локальное исследовательское приложение для моделирования аварийного истечения и распространения волны. Обязательные уведомления о сторонних программных компонентах находятся в THIRD_PARTY_NOTICES.txt." Foreground="#BFCEE2" LineHeight="23"/><TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MutedText}" Margin="0,18,0,0"/><Button Content="Проверить обновления" Click="CheckUpdates_Click" HorizontalAlignment="Left" Margin="0,15,0,0"/></StackPanel></Border>
            </StackPanel></ScrollViewer></Grid>
        </Grid>
        <!-- Состояние и выполнение -->
        <Border Grid.Row="2" Grid.Column="1" Background="#0F1727" BorderBrush="#26344B" BorderThickness="0,1,0,0"><Grid Margin="25,0"><TextBlock x:Name="Status" Text="Готов к работе · данные хранятся на вашем компьютере" Foreground="#7991AF" FontSize="10" VerticalAlignment="Center"/><TextBlock Text="RG-1D   /   1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#536B8B" FontSize="10"/></Grid></Border>
        <Border x:Name="BusyOverlay" Grid.Column="1" Grid.Row="1" Background="#E60C1220" Visibility="Collapsed">
            <Border Width="450" Background="#18263A" BorderBrush="#335268" BorderThickness="1" CornerRadius="22" Padding="35" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="≈" FontSize="55" Foreground="#4CE0C1" HorizontalAlignment="Center"/><TextBlock Text="Моделируем движение воды" FontSize="23" HorizontalAlignment="Center" Margin="0,5,0,12"/><TextBlock Text="Геометрия → поток → баланс → результаты" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,23"/><ProgressBar x:Name="CalculationProgress" Height="5" Maximum="100" Foreground="#4CE0C1" Background="#26374E" BorderThickness="0"/><TextBlock x:Name="ProgressText" Text="Подготовка расчётной сетки…" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,13,0,22"/><Button Content="Остановить расчёт" Click="Cancel_Click" HorizontalAlignment="Center"/></StackPanel></Border>
        </Border>
        <!-- Стартовое пространство -->
        <Grid x:Name="StartScreen" Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="20" Background="{StaticResource Bg}">
            <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Title_Drag"><Grid Margin="42,0,15,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#4CE0C1" CornerRadius="11" Width="37" Height="37"><TextBlock Text="≈" Foreground="#0B302D" FontSize="31" HorizontalAlignment="Center" Margin="0,-5,0,0"/></Border><StackPanel Margin="13,0,0,0"><TextBlock Text="RiverGuard" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="ПРОЕКТЫ И СЦЕНАРИИ" FontSize="9" Foreground="#8DA4BD"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CheckUpdatesButton" Content="Проверить обновления" Click="CheckUpdates_Click" Padding="14,9" Margin="0,0,12,0"/><Button x:Name="ResumeProjectButton" Content="Вернуться к проекту →" Click="Resume_Click" Visibility="Collapsed" Padding="14,9" Margin="0,0,22,0"/><Button Content="─" Click="Minimize_Click" Background="Transparent" BorderBrush="Transparent"/><Button Content="□" Click="Maximize_Click" Background="Transparent" BorderBrush="Transparent"/><Button Content="✕" Click="Close_Click" Background="Transparent" BorderBrush="Transparent"/></StackPanel></Grid></Border>
            <Grid x:Name="StartHomePanel" Grid.Row="1" Margin="48,35,36,26">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="50"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel VerticalAlignment="Center" Margin="0,15,0,0">
                    <TextBlock Text="Начните с проекта." FontSize="37" FontWeight="SemiBold" Margin="0,0,0,15"/><TextBlock Text="Импортируйте исходные данные или создайте проект с подходящим сценарием." Style="{StaticResource MutedText}" LineHeight="22" Margin="0,0,0,30"/>
                    <Button x:Name="ImportProjectButton" Click="Open_Click" Style="{StaticResource ProjectCardButton}" Background="#17273E" BorderBrush="#34506E" Padding="25,23"><StackPanel><TextBlock Text="↗" FontSize="28" Foreground="#89B4FF" Margin="0,0,0,10"/><TextBlock Text="Импорт проекта" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock Text="Открыть .riverguard или JSON исходных данных" Style="{StaticResource MutedText}"/></StackPanel></Button>
                    <Button x:Name="CreateNewProjectButton" Click="New_Click" Style="{StaticResource ProjectCardButton}" Background="#4CE0C1" BorderBrush="#4CE0C1" Foreground="#0B302D" Padding="25,23"><StackPanel><TextBlock Text="＋" FontSize="28" Margin="0,0,0,10"/><TextBlock Text="Создать новый проект" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock Text="Выберите механизм аварии и начальные данные" Foreground="#17564D" FontSize="12"/></StackPanel></Button>
                    <TextBlock Text="Работа локально · файлы остаются на вашем компьютере" Style="{StaticResource MutedText}" FontSize="10" Margin="0,15,0,0"/>
                </StackPanel></ScrollViewer>
                <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18"><TextBlock Text="Ваши проекты" FontSize="24" FontWeight="SemiBold"/><Button Content="Обновить" Click="RefreshLibrary_Click" HorizontalAlignment="Right" Padding="12,7" Margin="0"/></Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,16"><TextBox x:Name="ProjectSearch" TextChanged="ProjectSearch_Changed" ToolTip="Поиск по названию, сценарию или пути файла"/><TextBlock Text="Поиск по названию или сценарию…" Foreground="#6F88A6" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ProjectSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                    <Border Grid.Row="2" Background="#111C2D" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="16"><Grid><ScrollViewer><ItemsControl x:Name="ProjectLibraryList"><ItemsControl.ItemTemplate><DataTemplate>
                        <Grid x:Name="ProjectCard" Margin="0,0,0,12">
                            <Button Click="LibraryProject_Click" Tag="{Binding}" IsEnabled="{Binding IsAvailable}" Style="{StaticResource ProjectCardButton}" Background="#18283D" BorderBrush="#2B4059" Padding="20,17,120,17" Margin="0" ToolTip="{Binding Path}"><StackPanel><TextBlock Text="{Binding Label}" Foreground="#58D5BD" FontSize="9" Margin="0,0,0,7"/><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding Path}" Foreground="#617E9F" FontSize="10" Margin="0,8,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
                            <Button x:Name="DeleteProjectButton" Content="Удалить" Click="DeleteProject_Click" Tag="{Binding}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,17,0" Padding="12,9" Background="#432735" BorderBrush="#714052" Foreground="#FFA9B4" ToolTip="Удалить файл проекта в корзину Windows" AutomationProperties.Name="Удалить проект">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=ProjectCard}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ProjectCard}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel x:Name="EmptyLibraryPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"><TextBlock Text="▧" FontSize="42" Foreground="#4E7894" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyLibraryText" Text="Здесь будут ваши проекты" FontSize="19" HorizontalAlignment="Center" Margin="0,14,0,9"/><TextBlock Text="Создайте новый проект или импортируйте существующий файл." Style="{StaticResource MutedText}" TextAlignment="Center" MaxWidth="330"/></StackPanel></Grid></Border>
                    <Grid Grid.Row="3" Margin="0,15,0,0"><TextBlock x:Name="LibraryCountText" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center"/><Button Content="Открыть папку проектов ↗" Click="ProjectsFolder_Click" HorizontalAlignment="Right" Padding="9,6" FontSize="11" Margin="0"/></Grid>
                </Grid>
