                <StackPanel Margin="0,0,0,22"><Button Content="← Назад к проектам" Click="WizardBack_Click" HorizontalAlignment="Left" Padding="11,7" Margin="0,0,0,16"/><TextBlock Text="Новый проект" Style="{StaticResource Title}"/><TextBlock Text="Сначала выберите физический сценарий. Набор параметров в рабочем пространстве будет подстроен под него." Style="{StaticResource MutedText}"/></StackPanel>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}"><ScrollViewer><StackPanel><TextBlock Text="Название проекта" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NewProjectName" Text="Новый проект" Margin="0,0,0,23"/><TextBlock Text="МЕХАНИЗМ АВАРИИ" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,11"/>
                        <Button x:Name="BreachScenarioButton" Tag="breach" Click="ChooseScenario_Click" Style="{StaticResource ProjectCardButton}" Background="#1D3D47" BorderBrush="#4CE0C1" Padding="19,17"><StackPanel><TextBlock Text="Заданный проран" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock Text="Ширина, отметка порога и время формирования отверстия." Style="{StaticResource MutedText}"/></StackPanel></Button>
                        <Button x:Name="OverflowScenarioButton" Tag="overflow" Click="ChooseScenario_Click" Style="{StaticResource ProjectCardButton}" Background="#17273D" BorderBrush="#30465E" Padding="19,17"><StackPanel><TextBlock Text="Перелив через гребень" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock Text="Длина фиксированного гребня, его отметка и коэффициент расхода." Style="{StaticResource MutedText}"/></StackPanel></Button>
                        <Button x:Name="GateScenarioButton" Tag="gate" Click="ChooseScenario_Click" Style="{StaticResource ProjectCardButton}" Background="#17273D" BorderBrush="#30465E" Padding="19,17"><StackPanel><TextBlock Text="Аварийное открытие затвора" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock Text="Прямоугольное отверстие: ширина, высота и время подъёма." Style="{StaticResource MutedText}"/></StackPanel></Button>
                        <Button x:Name="CircularScenarioButton" Tag="circular" Click="ChooseScenario_Click" Style="{StaticResource ProjectCardButton}" Background="#17273D" BorderBrush="#30465E" Padding="19,17"><StackPanel><TextBlock Text="Круглое отверстие в теле плотины" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock Text="Заданный дефект: диаметр и нижняя отметка, без роста и размыва." Style="{StaticResource MutedText}"/></StackPanel></Button>
                        <CheckBox x:Name="UseDemoGeometry" IsChecked="True" Foreground="#BDCEE1" Content="Начать с демонстрационной геометрии долины" Margin="0,12,0,9"/><TextBlock Text="Если выключить, список створов будет пустым — добавьте собственные промеры." Style="{StaticResource MutedText}" FontSize="11"/>
                    </StackPanel></ScrollViewer></Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}"><ScrollViewer><StackPanel><TextBlock Text="РАБОЧЕЕ ПРОСТРАНСТВО" Foreground="#67DFC4" FontSize="10" Margin="0,0,0,14"/><TextBlock x:Name="WizardScenarioTitle" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock x:Name="WizardScenarioDescription" Foreground="#C4D4E8" LineHeight="23" Margin="0,0,0,20"/><TextBlock Text="СПЕЦИФИЧЕСКИЕ ПОЛЯ" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,10"/><TextBlock x:Name="WizardScenarioFields" Foreground="#72DFC6" LineHeight="25" Margin="0,0,0,23"/><TextBlock Text="ОБЩИЕ ДАННЫЕ" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,0,10"/><TextBlock Text="Водохранилище, нижний бьеф, рельеф створов, сопротивление и расчётная сетка." Foreground="#B0C4DC" LineHeight="23"/><Border Background="#2B251E" CornerRadius="10" Padding="14" Margin="0,23,0,0"><TextBlock Text="Эрозия, расчёт прочности, каскады плотин и двумерное растекание не включены. Выбор сценария не означает нормативной валидации модели." Foreground="#DBC195" FontSize="11"/></Border></StackPanel></ScrollViewer></Border>
                </Grid>
                <Grid Grid.Row="2" Margin="0,7,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="NewProjectLocation" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center" Margin="0,0,20,0"/><Button x:Name="FinishCreateButton" Grid.Column="1" Content="Создать проект  →" Style="{StaticResource Primary}" Click="FinishCreate_Click" Padding="24,13" Margin="0"/></Grid>
            </Grid>
            <TextBlock Grid.Row="2" Text="RiverGuard · Apdulium-beep · Исследовательская модель. Не является основанием для реальной эвакуации." Foreground="#7991AF" FontSize="10" Margin="48,0,40,0" VerticalAlignment="Center"/>
        </Grid>
        <!-- Переименование проекта -->
        <Grid x:Name="RenameOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" Panel.ZIndex="30" Background="#D90C1220" Visibility="Collapsed" PreviewKeyDown="Rename_KeyDown">
            <Border Width="490" Background="{StaticResource Card}" BorderBrush="#3A526C" BorderThickness="1" CornerRadius="19" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="Название проекта" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Название — это свойство проекта, а не расчётный параметр. Изменение сохранится в файл через Ctrl+S." Style="{StaticResource MutedText}" LineHeight="21" Margin="0,0,0,20"/><TextBox x:Name="RenameText" MinHeight="40"/><TextBlock x:Name="RenameError" Foreground="#FF9AA5" FontSize="11" Margin="0,9,0,0" Visibility="Collapsed"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Content="Отмена" Click="CancelRename_Click"/><Button Content="Применить" Click="ApplyRename_Click" Style="{StaticResource Primary}" Margin="0"/></StackPanel></StackPanel></Border>
        </Grid>
    </Grid>
</Window>
