<Window x:Class="RiverGuard.Updates.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Обновление RiverGuard" Width="610" Height="570" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" Closing="Window_Closing" PreviewKeyDown="Window_KeyDown">
    <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Доступно обновление" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="VersionLabel" Foreground="#4CE0C1" FontSize="15" Margin="0,12,0,12"/><TextBlock Text="Обновить RiverGuard сейчас? Новая версия установится отдельно, затем программа предложит сохранить изменения и перезапустится. Проекты останутся на месте." Foreground="#AFC1D8" LineHeight="21"/></StackPanel>
        <Button Grid.Row="1" Content="Открыть описание релиза ↗" Click="Release_Click" HorizontalAlignment="Left" Margin="0,14,0,12" Padding="10,7" FontSize="11"/>
        <Border Grid.Row="2" Background="#141E30" BorderBrush="#26344B" BorderThickness="1" CornerRadius="10" Padding="15"><ScrollViewer><TextBlock x:Name="ReleaseNotes" Foreground="#BBCDE1" FontSize="12" TextWrapping="Wrap"/></ScrollViewer></Border>
        <StackPanel Grid.Row="3" Margin="0,17,0,0"><ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="1" Visibility="Collapsed"/><TextBlock x:Name="ProgressText" Foreground="#AFC1D8" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" Text="Скачивание только с GitHub. Перед установкой проверяются SHA256, состав архива и версия EXE. Обновление не требует прав администратора."/></StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button x:Name="LaterButton" Content="Позже" Click="Later_Click" Padding="18,11"/><Button x:Name="InstallButton" Content="Обновить и перезапустить" Style="{StaticResource Primary}" Click="Install_Click" Padding="18,11" Margin="0"/></StackPanel>
    </Grid>
</Window>
